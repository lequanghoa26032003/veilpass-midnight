pragma language_version 0.23;

import CompactStandardLibrary;

// A credential secret is held locally by the user and never stored on-chain.
witness credentialSecret(): Bytes<32>;

// Only privacy-preserving claim nullifiers and an aggregate count are public.
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger totalClaims: Counter;

// A public commitment can be shared with an issuer without exposing the secret.
export pure circuit credentialCommitment(secret: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        pad(32, "veilpass:credential:"),
        secret
    ]);
}

// Claim once per campaign. The secret stays private; disclose intentionally
// reveals only an unlinkable, campaign-specific nullifier.
export circuit claimBenefit(campaignId: Bytes<32>): [] {
    const nullifier = disclose(
        persistentHash<Vector<3, Bytes<32>>>([
            pad(32, "veilpass:claim:"),
            campaignId,
            credentialSecret()
        ])
    );

    assert(!usedNullifiers.member(nullifier), "Benefit already claimed");
    usedNullifiers.insert(nullifier);
    totalClaims.increment(1);
}
